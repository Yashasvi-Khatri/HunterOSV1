{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:validate": "bun --env-file=.env.local prisma validate",
    "db:generate": "bun --env-file=.env.local prisma generate",
    "db:push": "bun --env-file=.env.local prisma db push",
    "db:migrate": "bun --env-file=.env.local prisma migrate dev",
    "db:studio": "bun --env-file=.env.local prisma studio",
    "db:test": "bun --env-file=.env.local scripts/test-db.ts",
    "db:test-storage": "bun --env-file=.env.local scripts/test-storage.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "5",
    "@repo/ui": "*",
    "next": "^16.2.1",
    "next-auth": "^4.24.14",
    "openai": "^4.40.0",
    "prisma": "5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
