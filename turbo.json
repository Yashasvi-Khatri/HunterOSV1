{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["OPENROUTER_API_KEY", "OPENAI_API_KEY", "NEXT_PUBLIC_APP_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["OPENROUTER_API_KEY", "OPENAI_API_KEY", "NEXT_PUBLIC_APP_URL"],
      "passThroughEnv": ["OPENROUTER_API_KEY", "OPENAI_API_KEY", "NEXT_PUBLIC_APP_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    }
  }
}
